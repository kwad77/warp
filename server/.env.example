# Copy to .env for local development (npm run dev loads it via --env-file).
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://wanderpost:wanderpost@localhost:5432/wanderpost
# Any string ≥ 32 chars in dev; a real secret in production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# Cloudflare R2 (optional until photo routes are enabled)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=wanderpost-photos
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
