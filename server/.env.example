# Copy to .env for local development (npm run dev loads it via --env-file).
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://wanderpost:wanderpost@localhost:5432/wanderpost
# Any string ≥ 32 chars in dev; a real secret in production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# Cloudflare R2 (optional until photo routes are enabled)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=wanderpost-photos
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...

# 'dev' auto-approves every photo (SPEC §6). 'rekognition' is a named seam only — no
# detector is wired in yet, so selecting it returns 501 rather than actually moderating.
MODERATION_PROVIDER=dev

# Sign in with Apple/Google (SPEC §4). The verification code is real; these are the app's
# bundle id / OAuth client id from Apple Developer / Google Cloud console. Unset (the
# default) ⇒ POST /auth/apple and /auth/google both return 501 service/unavailable.
# APPLE_CLIENT_ID=...
# GOOGLE_CLIENT_ID=...
